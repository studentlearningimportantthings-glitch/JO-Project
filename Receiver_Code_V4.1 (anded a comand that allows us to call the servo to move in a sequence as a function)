#include <WiFi.h>
#include <esp_now.h>
#include <ESP32Servo.h>

// ---- LEDs ----
#define LED_PIN 2          // blink LED
#define PAUSE_LED_PIN 15   // lights while the sender is paused

// ---- Motor driver pins (BTS7960) ----
const int RPWM = 32;       // forward PWM                        Real pin
const int LPWM = 33;       // reverse PWM                       Real pin 
const int R_EN = 25;       // enable forward half-bridge        Not hooked too
const int L_EN = 26;       // enable reverse half-bridge        Not hooked too
const int SERVO_PIN = 18;  // servo signal                      Real Pin

Servo myServo;

// Must match the sender exactly
typedef struct {
  int count;
  bool ledState;
  bool paused;
} Message;

Message msg;

// ---- Sequence state ----
// 0 = idle, 1 = forward, 2 = short stop, 3 = reverse
int seqStep = 0;
unsigned long stepStart = 0;
bool lastPaused = false;
bool firstMessage = true;               // first message only syncs state
volatile bool startRequested = false;   // set by the radio callback, read in loop()

// ---- Motor functions (speed: 0 to 255) ----
void forward(int speed) {
  analogWrite(LPWM, 0);       // keep the opposite side off
  analogWrite(RPWM, speed);
}

void reverse(int speed) {
  analogWrite(RPWM, 0);
  analogWrite(LPWM, speed);
}

void stopMotor() {
  analogWrite(RPWM, 0);
  analogWrite(LPWM, 0);
}

// ---- NEW: Servo move, 0 degrees then 15 degrees (non-blocking) ----
const unsigned long SERVO_HOLD_MS = 500;   // time spent at 0 before going to 15
int servoMoveStep = 0;                     // 0 = idle, 1 = waiting at 0 degrees
unsigned long servoMoveStart = 0;

// Call this to start the move: servo goes to 0, then 15 after SERVO_HOLD_MS
void servoZeroThen15() {
  if (servoMoveStep != 0) return;          // already running, ignore
  myServo.write(0);
  servoMoveStart = millis();
  servoMoveStep = 1;
}

// Called from loop(): finishes the move once the hold time is up
void updateServoMove() {
  if (servoMoveStep == 1 && millis() - servoMoveStart >= SERVO_HOLD_MS) {
    myServo.write(15);
    servoMoveStep = 0;
  }
}

// Runs automatically whenever a message arrives
// (on older ESP32 core 2.x, change the first parameter to: const uint8_t *mac)
void onReceive(const esp_now_recv_info_t *info, const uint8_t *data, int len) {
  if (len != sizeof(msg)) return;   // NEW: ignore messages with the wrong size

  memcpy(&msg, data, sizeof(msg));
  digitalWrite(LED_PIN, msg.ledState);
  digitalWrite(PAUSE_LED_PIN, msg.paused);

  // The first message only syncs the state, it never starts the motor
  if (firstMessage) {
    lastPaused = msg.paused;
    firstMessage = false;
  } else {
    // Start the motor sequence only at the moment the button is pressed
    if (msg.paused && !lastPaused) {
      startRequested = true;
    }
    lastPaused = msg.paused;
  }

  Serial.printf("Received #%d, LED=%d, paused=%d\n", msg.count, msg.ledState, msg.paused);
}

void setup() {
  Serial.begin(115200);
  pinMode(LED_PIN, OUTPUT);
  pinMode(PAUSE_LED_PIN, OUTPUT);
  digitalWrite(PAUSE_LED_PIN, LOW);

  pinMode(RPWM, OUTPUT);
  pinMode(LPWM, OUTPUT);
  pinMode(R_EN, OUTPUT);
  pinMode(L_EN, OUTPUT);
  digitalWrite(R_EN, LOW);    // driver stays disabled until the button is pressed
  digitalWrite(L_EN, LOW);    // (only has an effect if R_EN / L_EN are wired)
  stopMotor();

  ESP32PWM::allocateTimer(0);
  ESP32PWM::allocateTimer(1);

  myServo.setPeriodHertz(50);
  myServo.attach(SERVO_PIN, 500, 2400);
  myServo.write(90);
  // NEW: shows in the Serial Monitor whether the servo attached correctly
  Serial.println(myServo.attached() ? "Servo attached: YES" : "Servo attached: NO");

  WiFi.mode(WIFI_STA);
  if (esp_now_init() != ESP_OK) {
    Serial.println("ESP-NOW init failed");
    return;
  }
  esp_now_register_recv_cb(onReceive);
}

void loop() {
  updateServoMove();   // NEW: keeps the 0-then-15 servo move running

  // Button press arrived: begin the sequence (unless one is already running)
  if (startRequested) {
    startRequested = false;
    if (seqStep == 0) {
      seqStep = 1;
      stepStart = millis();
      digitalWrite(R_EN, HIGH);   // enable the driver only while the sequence runs
      digitalWrite(L_EN, HIGH);
      forward(40);
      myServo.write(0);
      Serial.println("Motor sequence started");
    }
  }

  unsigned long elapsed = millis() - stepStart;

  if (seqStep == 1 && elapsed >= 2000) {          // forward done
    stopMotor();
    myServo.write(90);
    seqStep = 2;
    stepStart = millis();
  } else if (seqStep == 2 && elapsed >= 500) {    // short stop done
    reverse(200);
    myServo.write(180);
    seqStep = 3;
    stepStart = millis();
  } else if (seqStep == 3 && elapsed >= 2000) {   // reverse done
    stopMotor();
    digitalWrite(R_EN, LOW);                      // disable the driver again
    digitalWrite(L_EN, LOW);
    myServo.write(90);
    seqStep = 0;
    Serial.println("Motor sequence finished");
  }
}
