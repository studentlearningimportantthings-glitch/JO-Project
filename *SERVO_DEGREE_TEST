//ServoRangeTest

// Servo range test: find the real min/max of your servo
// Type commands in the Serial Monitor (115200 baud, line ending: Newline)
//   0 to 180      -> move to that angle
//   400 to 2600   -> move to that pulse width in microseconds
//   s             -> slow sweep 0 -> 180 -> 0
 
#include <ESP32Servo.h>
 
const int SERVO_PIN = 18;
const int MIN_US = 500;     // wide range on purpose, so you can find the real limits
const int MAX_US = 2500;
 
Servo s;
 
void sweep() {
  Serial.println("Sweep 0 -> 180");
  for (int a = 0; a <= 180; a += 5) {
    s.write(a);
    Serial.println(a);
    delay(150);
  }
  delay(500);
 
  Serial.println("Sweep 180 -> 0");
  for (int a = 180; a >= 0; a -= 5) {
    s.write(a);
    Serial.println(a);
    delay(150);
  }
  Serial.println("Sweep done");
}
 
void setup() {
  Serial.begin(115200);
 
  ESP32PWM::allocateTimer(0);
  ESP32PWM::allocateTimer(1);
 
  s.setPeriodHertz(50);
  s.attach(SERVO_PIN, MIN_US, MAX_US);
 
  Serial.println(s.attached() ? "Servo attached: YES" : "Servo attached: NO");
  Serial.println("Commands: 0-180 (angle), 400-2600 (microseconds), s (sweep)");
 
  s.write(90);   // start centered
}
 
void loop() {
  if (!Serial.available()) return;
 
  String in = Serial.readStringUntil('\n');
  in.trim();
  if (in.length() == 0) return;
 
  if (in == "s" || in == "S") {
    sweep();
  } else if (isDigit(in[0])) {
    int v = in.toInt();
    if (v >= 0 && v <= 180) {
      s.write(v);
      Serial.printf("Angle: %d degrees\n", v);
    } else if (v >= 400 && v <= 2600) {
      s.writeMicroseconds(v);
      Serial.printf("Pulse: %d us\n", v);
    } else {
      Serial.println("Out of range. Use 0-180 or 400-2600.");
    }
  } else {
    Serial.println("Commands: 0-180 (angle), 400-2600 (microseconds), s (sweep)");
  }
}
